"use client";

import { AnimatePresence, motion, useDragControls, useReducedMotion } from "motion/react";
import { useEffect, useMemo, useRef, useState, type PointerEvent as ReactPointerEvent } from "react";

type AppId = "welcome" | "case" | "files" | "terminal" | "about";
type VirtualFile = { name: string; content: string; type: "folder" | "file" };

const STORAGE_KEY = "arhaan-cyberdesk-v2";
const DEFAULT_FILES: VirtualFile[] = [
  { name: "case-files", content: "", type: "folder" },
  { name: "case-notes.txt", content: "Start with the Mystery Case. Look for what happened first.", type: "file" },
  { name: "ideas.txt", content: "", type: "file" },
];

const CLUES = [
  {
    id: "email",
    time: "09:08",
    title: "Unexpected email",
    text: "Maya received a message telling her to verify her account using a shortened link.",
  },
  {
    id: "login",
    time: "09:12",
    title: "Unusual sign-in",
    text: "A successful sign-in happened from a new location after several failed attempts.",
  },
  {
    id: "file",
    time: "09:16",
    title: "Sensitive file accessed",
    text: "The same account opened a confidential folder just four minutes later.",
  },
];

function formatTime(date: Date) {
  return new Intl.DateTimeFormat("en", { hour: "2-digit", minute: "2-digit" }).format(date);
}

function createVisitorCode() {
  return Math.random().toString(36).slice(2, 8).toUpperCase();
}

export function CyberDesk() {
  const desktopRef = useRef<HTMLDivElement | null>(null);
  const reducedMotion = useReducedMotion();
  const [activeApp, setActiveApp] = useState<AppId>("welcome");
  const [clock, setClock] = useState("--:--");
  const [caseSolved, setCaseSolved] = useState(false);
  const [selectedClue, setSelectedClue] = useState("email");
  const [caseFeedback, setCaseFeedback] = useState("");
  const [files, setFiles] = useState<VirtualFile[]>(DEFAULT_FILES);
  const [activeFile, setActiveFile] = useState("case-notes.txt");
  const [fileContent, setFileContent] = useState("Start with the Mystery Case. Look for what happened first.");
  const [newFileOpen, setNewFileOpen] = useState(false);
  const [newFileName, setNewFileName] = useState("");
  const [terminalLines, setTerminalLines] = useState<string[]>([
    "Welcome to the Cyber Desk sandbox.",
    'Type "help" to see what you can explore.',
  ]);
  const [terminalInput, setTerminalInput] = useState("");
  const [visitorCode, setVisitorCode] = useState("------");
  const [saved, setSaved] = useState(false);
  const [hydrated, setHydrated] = useState(false);

  useEffect(() => {
    setClock(formatTime(new Date()));
    const timer = window.setInterval(() => setClock(formatTime(new Date())), 30000);
    return () => window.clearInterval(timer);
  }, []);

  useEffect(() => {
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const data = JSON.parse(raw) as {
          caseSolved?: boolean;
          files?: VirtualFile[];
          activeFile?: string;
          visitorCode?: string;
        };
        setCaseSolved(Boolean(data.caseSolved));
        if (Array.isArray(data.files) && data.files.length > 0) setFiles(data.files);
        if (typeof data.activeFile === "string") setActiveFile(data.activeFile);
        if (typeof data.visitorCode === "string") setVisitorCode(data.visitorCode);
      } else {
        const code = createVisitorCode();
        setVisitorCode(code);
      }
    } catch {
      const code = createVisitorCode();
      setVisitorCode(code);
    } finally {
      setHydrated(true);
    }
  }, []);

  useEffect(() => {
    if (!hydrated) return;

    const current = files.find((item) => item.name === activeFile);
    if (current?.type === "file") {
      setFileContent(current.content);
    }
  }, [hydrated, activeFile, files]);

  useEffect(() => {
    if (!hydrated) return;

    try {
      window.localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          caseSolved,
          files,
          activeFile,
          visitorCode,
        }),
      );
      setSaved(true);
    } catch {
      setSaved(false);
    }
  }, [hydrated, caseSolved, files, activeFile, visitorCode]);

  const openApp = (app: AppId) => {
    setActiveApp(app);
    if (app === "files") {
      const firstFile = files.find((item) => item.type === "file");
      if (firstFile) {
        setActiveFile(firstFile.name);
        setFileContent(firstFile.content);
      }
    }
  };

  const closeApp = () => setActiveApp("welcome");

  const updateCurrentFile = (content: string) => {
    setFileContent(content);
    setFiles((current) =>
      current.map((item) =>
        item.name === activeFile ? { ...item, content } : item,
      ),
    );
  };

  const createFile = () => {
    const cleaned = newFileName.trim().replace(/[^a-zA-Z0-9._-]/g, "-");
    if (!cleaned) return;

    const finalName = cleaned.includes(".") ? cleaned : `${cleaned}.txt`;
    if (files.some((item) => item.name === finalName)) {
      setNewFileName("");
      return;
    }

    setFiles((current) => [...current, { name: finalName, content: "", type: "file" }]);
    setActiveFile(finalName);
    setFileContent("");
    setNewFileName("");
    setNewFileOpen(false);
  };

  const runTerminalCommand = () => {
    const command = terminalInput.trim();
    if (!command) return;

    const normalized = command.toLowerCase();
    let output: string[];

    if (normalized === "help") {
      output = [
        "help      list available commands",
        "ls        view the virtual desktop files",
        "pwd       show the sandbox path",
        "about     open Arhaan's profile",
        "case      open Mystery Case 01",
        "clear     clear this terminal",
      ];
    } else if (normalized === "ls") {
      output = files.map((item) => (item.type === "folder" ? `${item.name}/` : item.name));
    } else if (normalized === "pwd") {
      output = ["/home/visitor/cyber-desk"];
    } else if (normalized === "about") {
      openApp("about");
      output = ["Opening profile…"];
    } else if (normalized === "case") {
      openApp("case");
      output = ["Opening Mystery Case 01…"];
    } else if (normalized === "clear") {
      setTerminalLines([]);
      setTerminalInput("");
      return;
    } else {
      output = [
        `Command not available: ${command}`,
        "This is a safe virtual sandbox. Try help, ls, pwd, about, case, or clear.",
      ];
    }

    setTerminalLines((current) => [...current, `visitor@desk:~$ ${command}`, ...output]);
    setTerminalInput("");
  };

  const apps = useMemo(
    () => [
      { id: "case" as AppId, label: "Mystery Case", sub: caseSolved ? "Solved" : "01 / Beginner", icon: "?" },
      { id: "files" as AppId, label: "My Files", sub: `${files.filter((file) => file.type === "file").length} files`, icon: "▣" },
      { id: "terminal" as AppId, label: "Terminal", sub: "Safe sandbox", icon: ">_" },
      { id: "about" as AppId, label: "About Arhaan", sub: "Portfolio", icon: "AS" },
    ],
    [caseSolved, files],
  );

  return (
    <div className="cyber-desk reveal" aria-label="Interactive Cyber Desk">
      <div className="cyber-os">
        <header className="cyber-os-topbar">
          <button type="button" className="cyber-os-brand" onClick={() => openApp("welcome")}>
            <span className="cyber-os-brand-mark">A</span>
            <span>ARHAAN DESK</span>
          </button>
          <div className="cyber-os-status">
            <span><i /> SYSTEM READY</span>
            <span>{clock}</span>
          </div>
        </header>

        <div className="cyber-os-workspace" ref={desktopRef}>
          <div className="cyber-os-wallpaper" aria-hidden="true">
            <span className="cyber-wallpaper-orb cyber-wallpaper-orb-a" />
            <span className="cyber-wallpaper-orb cyber-wallpaper-orb-b" />
            <span className="cyber-wallpaper-line cyber-wallpaper-line-a" />
            <span className="cyber-wallpaper-line cyber-wallpaper-line-b" />
          </div>

          <div className="cyber-desktop-icons">
            {apps.map((app) => (
              <motion.button
                type="button"
                key={app.id}
                className={`cyber-desktop-icon${activeApp === app.id ? " is-active" : ""}`}
                onClick={() => openApp(app.id)}
                whileTap={{ scale: 0.96 }}
              >
                <span className={`cyber-desktop-icon-glyph cyber-glyph-${app.id}`}>{app.icon}</span>
                <strong>{app.label}</strong>
                <small>{app.sub}</small>
              </motion.button>
            ))}
          </div>

          <AnimatePresence mode="wait">
            {activeApp === "welcome" ? (
              <motion.div
                key="welcome"
                className="cyber-app-window cyber-app-window-welcome"
                initial={{ opacity: 0, scale: reducedMotion ? 1 : 0.97, y: reducedMotion ? 0 : 8 }}
                animate={{ opacity: 1, scale: 1, y: 0 }}
                exit={{ opacity: 0, scale: reducedMotion ? 1 : 0.98, y: 6 }}
                transition={{ duration: 0.22 }}
              >
                <WindowHeader title="Welcome" onClose={() => setActiveApp("welcome")} />
                <div className="cyber-welcome-app">
                  <span className="cyber-app-kicker">A SMALL DIGITAL WORLD</span>
                  <h3>Welcome to Arhaan&apos;s desk.</h3>
                  <p>Nothing here is real infrastructure. Explore freely, solve a tiny mystery, and leave yourself a note.</p>

                  <div className="cyber-welcome-actions">
                    <button type="button" onClick={() => openApp("case")} className="cyber-primary-chip">
                      <span>OPEN MYSTERY CASE</span><b>→</b>
                    </button>
                    <button type="button" onClick={() => openApp("files")} className="cyber-secondary-chip">
                      <span>EXPLORE FILES</span><b>+</b>
                    </button>
                  </div>

                  <div className="cyber-welcome-foot">
                    <span>NO TECHNICAL KNOWLEDGE NEEDED</span>
                    <span>VISITOR {visitorCode}</span>
                  </div>
                </div>
              </motion.div>
            ) : null}

            {activeApp === "case" ? (
              <motion.div
                key="case"
                className="cyber-app-window"
                initial={{ opacity: 0, scale: reducedMotion ? 1 : 0.97, y: reducedMotion ? 0 : 8 }}
                animate={{ opacity: 1, scale: 1, y: 0 }}
                exit={{ opacity: 0, scale: reducedMotion ? 1 : 0.98, y: 6 }}
                transition={{ duration: 0.22 }}
              >
                <WindowHeader title="Mystery Case 01" onClose={closeApp} />
                <div className="cyber-case-app">
                  <div className="cyber-app-title-row">
                    <div>
                      <span className="cyber-app-kicker">BEGINNER INVESTIGATION</span>
                      <h3>The strange sign-in</h3>
                    </div>
                    <span className={caseSolved ? "cyber-app-badge is-done" : "cyber-app-badge"}>{caseSolved ? "SOLVED" : "OPEN"}</span>
                  </div>

                  <p className="cyber-case-intro">Maya&apos;s work account was accessed this morning. Read the clues in order and decide what most likely started the incident.</p>

                  <div className="cyber-clue-list">
                    {CLUES.map((clue) => (
                      <button
                        type="button"
                        key={clue.id}
                        className={selectedClue === clue.id ? "cyber-clue is-selected" : "cyber-clue"}
                        onClick={() => setSelectedClue(clue.id)}
                      >
                        <span className="cyber-clue-time">{clue.time}</span>
                        <span><strong>{clue.title}</strong><small>{clue.text}</small></span>
                        <b>{selectedClue === clue.id ? "−" : "+"}</b>
                      </button>
                    ))}
                  </div>

                  {!caseSolved ? (
                    <div className="cyber-case-answer">
                      <span className="cyber-app-kicker">WHAT MOST LIKELY STARTED IT?</span>
                      <div className="cyber-case-options">
                        <button type="button" onClick={() => { setCaseSolved(true); setCaseFeedback(""); }}>A&nbsp;&nbsp;A convincing fake email</button>
                        <button type="button" onClick={() => setCaseFeedback("Not quite. Look at the timestamps. What happened before the sign-in?")}>B&nbsp;&nbsp;A routine software update</button>
                        <button type="button" onClick={() => setCaseFeedback("Try again. The sign-in is the result, not the first clue.")}>C&nbsp;&nbsp;A Wi-Fi problem</button>
                      </div>
                      {caseFeedback ? <p className="cyber-case-hint">{caseFeedback}</p> : null}
                    </div>
                  ) : (
                    <div className="cyber-case-success">
                      <span className="cyber-success-mark">✓</span>
                      <div>
                        <strong>Nice detective work.</strong>
                        <p>The fake email was the likely starting point. Real investigations use more evidence before reaching a final conclusion.</p>
                        <button type="button" onClick={() => { setCaseSolved(false); setCaseFeedback(""); }}>PLAY AGAIN</button>
                      </div>
                    </div>
                  )}

                  <div className="cyber-app-foot"><span>FICTIONAL TRAINING SCENARIO</span><span>{caseSolved ? "01 / 01 COMPLETE" : "01 / 01"} · BEGINNER</span></div>
                </div>
              </motion.div>
            ) : null}

            {activeApp === "files" ? (
              <motion.div
                key="files"
                className="cyber-app-window"
                initial={{ opacity: 0, scale: reducedMotion ? 1 : 0.97, y: reducedMotion ? 0 : 8 }}
                animate={{ opacity: 1, scale: 1, y: 0 }}
                exit={{ opacity: 0, scale: reducedMotion ? 1 : 0.98, y: 6 }}
                transition={{ duration: 0.22 }}
              >
                <WindowHeader title="My Files" onClose={closeApp} />
                <div className="cyber-files-app">
                  <aside className="cyber-file-tree">
                    <div className="cyber-file-tree-heading"><span>PLACES</span><button type="button" onClick={() => setNewFileOpen(true)} aria-label="Create new file">+</button></div>
                    <button type="button" className="cyber-file-folder is-selected"><span>⌂</span> Home</button>
                    <div className="cyber-file-items">
                      {files.map((file) => (
                        <button
                          type="button"
                          key={file.name}
                          className={file.name === activeFile ? "is-active" : ""}
                          onClick={() => {
                            if (file.type === "file") {
                              setActiveFile(file.name);
                              setFileContent(file.content);
                            }
                          }}
                        >
                          <span>{file.type === "folder" ? "▰" : "▤"}</span>{file.name}
                        </button>
                      ))}
                    </div>
                  </aside>

                  <div className="cyber-file-editor">
                    <div className="cyber-file-editor-top">
                      <div><span className="cyber-app-kicker">PLAIN TEXT</span><strong>{activeFile}</strong></div>
                      <button type="button" onClick={() => setNewFileOpen(true)}>NEW FILE</button>
                    </div>
                    <textarea
                      value={fileContent}
                      onChange={(event) => updateCurrentFile(event.target.value)}
                      aria-label={`Edit ${activeFile}`}
                      placeholder="Write something..."
                    />
                    <div className="cyber-file-editor-foot"><span>{fileContent.length} characters</span><span>{saved ? "✓ AUTO-SAVED" : "STORAGE UNAVAILABLE"}</span></div>
                    {newFileOpen ? (
                      <div className="cyber-new-file">
                        <input
                          value={newFileName}
                          onChange={(event) => setNewFileName(event.target.value)}
                          onKeyDown={(event) => { if (event.key === "Enter") createFile(); }}
                          placeholder="new-file"
                          aria-label="New file name"
                          autoFocus
                        />
                        <button type="button" onClick={createFile}>CREATE</button>
                        <button type="button" onClick={() => { setNewFileOpen(false); setNewFileName(""); }}>CANCEL</button>
                      </div>
                    ) : null}
                  </div>
                </div>
              </motion.div>
            ) : null}

            {activeApp === "terminal" ? (
              <motion.div
                key="terminal"
                className="cyber-app-window cyber-terminal-window"
                initial={{ opacity: 0, scale: reducedMotion ? 1 : 0.97, y: reducedMotion ? 0 : 8 }}
                animate={{ opacity: 1, scale: 1, y: 0 }}
                exit={{ opacity: 0, scale: reducedMotion ? 1 : 0.98, y: 6 }}
                transition={{ duration: 0.22 }}
              >
                <WindowHeader title="Terminal" onClose={closeApp} />
                <div className="cyber-terminal-app">
                  <div className="cyber-terminal-output" aria-live="polite">
                    {terminalLines.map((line, index) => <div key={index}>{line}</div>)}
                  </div>
                  <div className="cyber-terminal-input">
                    <span>visitor@desk:~$</span>
                    <input
                      value={terminalInput}
                      onChange={(event) => setTerminalInput(event.target.value)}
                      onKeyDown={(event) => { if (event.key === "Enter") runTerminalCommand(); }}
                      aria-label="Cyber Desk terminal input"
                      autoComplete="off"
                      spellCheck={false}
                    />
                  </div>
                  <span className="cyber-terminal-note">SAFE SANDBOX · COMMANDS ONLY AFFECT THIS LITTLE DESKTOP</span>
                </div>
              </motion.div>
            ) : null}

            {activeApp === "about" ? (
              <motion.div
                key="about"
                className="cyber-app-window"
                initial={{ opacity: 0, scale: reducedMotion ? 1 : 0.97, y: reducedMotion ? 0 : 8 }}
                animate={{ opacity: 1, scale: 1, y: 0 }}
                exit={{ opacity: 0, scale: reducedMotion ? 1 : 0.98, y: 6 }}
                transition={{ duration: 0.22 }}
              >
                <WindowHeader title="About Arhaan" onClose={closeApp} />
                <div className="cyber-about-app">
                  <div className="cyber-about-profile">
                    <div className="cyber-about-monogram">AS</div>
                    <div><span className="cyber-app-kicker">CYBERSECURITY</span><h3>Arhaan Shaikh</h3><p>MCA student building practical skills in web security, VAPT, Linux, and networking.</p></div>
                  </div>
                  <div className="cyber-about-grid">
                    <div><span>FOCUS</span><strong>WEB SECURITY · VAPT</strong></div>
                    <div><span>LEARNING</span><strong>LINUX · NETWORKING</strong></div>
                    <div><span>WORK STYLE</span><strong>LEARN · BUILD · SECURE</strong></div>
                    <a href="#projects"><span>PORTFOLIO</span><strong>VIEW PROJECTS ↗</strong></a>
                  </div>
                </div>
              </motion.div>
            ) : null}
          </AnimatePresence>

          <div className="cyber-os-dock" aria-label="Cyber Desk app launcher">
            <button type="button" className="cyber-dock-home" onClick={() => openApp("welcome")} aria-label="Open desk home">A.</button>
            {apps.map((app) => (
              <button type="button" className={activeApp === app.id ? "is-active" : ""} key={app.id} onClick={() => openApp(app.id)} aria-label={app.label}>
                <span>{app.icon}</span>
                {activeApp === app.id ? <i /> : null}
              </button>
            ))}
          </div>
        </div>

        <footer className="cyber-os-footer">
          <span><i /> LOCAL SANDBOX</span>
          <span>{saved ? "YOUR PROGRESS IS SAVED ON THIS DEVICE" : "READY TO EXPLORE"}</span>
          <span>PROFILE {visitorCode}</span>
        </footer>
      </div>
    </div>
  );
}

function WindowHeader({ title, onClose }: { title: string; onClose: () => void }) {
  const controls = useDragControls();

  const handlePointerDown = (event: ReactPointerEvent<HTMLDivElement>) => {
    controls.start(event);
  };

  return (
    <motion.div className="cyber-window-header" onPointerDown={handlePointerDown}>
      <div className="cyber-window-dots" aria-hidden="true"><i /><i /><i /></div>
      <span>{title}</span>
      <button
        type="button"
        className="cyber-window-close"
        onPointerDown={(event) => event.stopPropagation()}
        onClick={(event) => { event.stopPropagation(); onClose(); }}
        aria-label={`Close ${title}`}
      >×</button>
    </motion.div>
  );
}
